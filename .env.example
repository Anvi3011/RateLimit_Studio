# Docker Compose local settings. Use URL-safe hex secrets (see README).
POSTGRES_DB=ratelimit_studio
POSTGRES_USER=ratelimit_user
POSTGRES_PASSWORD=replace-with-a-secure-database-password
SESSION_SECRET=replace-with-a-64-character-hex-session-secret
FAULTS_ENABLED=false
RABBITMQ_USER=replace-with-random-username
RABBITMQ_PASSWORD=replace-with-a-64-character-hex-secret
FRONTEND_ORIGIN=http://localhost:8080
RATE_LIMIT_FAIL_MODE=closed
OUTBOX_CAPACITY=5000
LOG_RETENTION_HOURS=24
HTTP_PORT=8080
TLS_CERT_DIR=./deployment/tls
NUM_PROXIES=2

# Internal DATABASE_URL, REDIS_URL and RABBITMQ_URL are assembled by Compose.
# API_PORT and WORKER_ID are not used by the current stack.
# TLS_CERT_DIR is used only by the optional tls profile.
