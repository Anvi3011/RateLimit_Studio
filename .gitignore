# Environment files: publish only the explicitly sanitized template.
.env
.env.*
!.env.example
!.env.*.example

# Cloud, SSH, and local credential material.
.aws/
.ssh/
AWS-Keys/
**/.aws/
**/.ssh/
**/AWS-Keys/
**/credentials
**/credentials.*
**/aws-credentials*
**/id_rsa
**/id_ed25519
**/config.secret
.git-credentials
.netrc
.npmrc
.pypirc
.docker/
**/.docker/
*.secret
*.secrets
credentials.json
service-account*.json
*-service-account*.json
id_rsa
id_ed25519
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
*.tfstate
*.tfstate.*

# Local environments, caches, generated builds, and test artifacts.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
node_modules/
dist/
build/
coverage/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
playwright/.cache/
*.log
*.pid

# OS and editor files.
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local measured reports, backups, temporary release worktrees, and certs.
benchmarks/reports/*
!benchmarks/reports/.gitkeep
backups/
*.bak
*.backup
*.backup.*
*.old
*.orig
.releases/
deployment/tls/*
!deployment/tls/.gitkeep
