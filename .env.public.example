# Reference only: enter values privately in Render. Do not replace local .env.
PUBLIC_DEMO=true
REQUIRE_POSTGRES=true
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@NEON_POOLER_HOST/DATABASE?sslmode=require&connect_timeout=5
REDIS_URL=rediss://default:URL_ENCODED_PASSWORD@UPSTASH_HOST:6379/0
RABBITMQ_URL=amqps://USER:URL_ENCODED_PASSWORD@CLOUDAMQP_HOST/PROVIDER_VHOST
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
FRONTEND_ORIGIN=https://YOUR_PROJECT.vercel.app
FAULTS_ENABLED=false
RATE_LIMIT_FAIL_MODE=closed
LOG_RETENTION_HOURS=24
OUTBOX_CAPACITY=1000
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=5
DB_CONNECT_TIMEOUT=5
REDIS_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
AMQP_PROBE_TIMEOUT=2
HEARTBEAT_INTERVAL=30
PUBLISHER_BLOCK_SECONDS=20
# Public mode forces Secure cookies and trusts no incoming forwarding headers.
# Header identity remains accurate; IP identity groups traffic by Render proxy.
PROXY_X_FOR=0
PROXY_X_PROTO=0
PROXY_X_HOST=0
